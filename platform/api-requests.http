@baseUrl = http://localhost:8080
# @baseUrl = http://foyez.runs.onstackit.cloud
@apiV1 = {{baseUrl}}/api/v1
@contentType = application/json
@instanceID = d5d9cf42-7905-47f8-a03c-03078f9bc719

### Create Instance
POST {{apiV1}}/instances
Idempotency-Key: 8ad1fdf6-4b6e-48b0-bec2-3c6c4f386635
Content-Type: {{contentType}}

{
  "name": "my-db-2",
  "version": 15,
  "storage": "7Gi"
}

### Get an instance
GET {{apiV1}}/instances/{{instanceID}}

### List Instances
GET {{apiV1}}/instances

### Update Instance
PATCH {{apiV1}}/instances/{{instanceID}}
Content-Type: {{contentType}}

{
  "version": 15,
  "storage": "7Gi"
}

### Delete Instance
DELETE {{apiV1}}/instances/{{instanceID}}