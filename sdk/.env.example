# Configuration for `make test-integration` and examples/provision.
# Copy to .env (git-ignored). Values for the local platform (`make dev`)
# come from the root of the repository:
#   terraform -chdir=hack/dev/terraform output -raw sdk_client_id
#   terraform -chdir=hack/dev/terraform output -raw sdk_client_secret
#   terraform -chdir=hack/dev/terraform output -raw project_id
DBAAS_API_URL=http://api.dbaas.localhost
DBAAS_TOKEN_URL=http://auth.dbaas.localhost/oauth/v2/token
DBAAS_CLIENT_ID=<sdk_client_id>
DBAAS_CLIENT_SECRET=<sdk_client_secret>
DBAAS_PROJECT_ID=<project_id>
